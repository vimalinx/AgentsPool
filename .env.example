# Generate each token with: agentspool token
AGENTSPOOL_ADMIN_TOKEN=replace-with-a-random-admin-token-at-least-24-characters
AGENTSPOOL_ALLOCATOR_TOKEN=replace-with-a-different-random-allocator-token-at-least-24-characters
AGENTSPOOL_JOIN_TOKEN=replace-with-a-different-random-join-token-at-least-24-characters
# Non-Compose CLI/services may instead use AGENTSPOOL_ADMIN_TOKEN_FILE and
# AGENTSPOOL_ALLOCATOR_TOKEN_FILE and AGENTSPOOL_JOIN_TOKEN_FILE. Never configure both forms for the same token.

# CLI and worker defaults
AGENTSPOOL_SERVER=http://127.0.0.1:8090

# Optional server settings
AGENTSPOOL_LISTEN=127.0.0.1:8090
AGENTSPOOL_DATA_DIR=/var/lib/agentspool/server
AGENTSPOOL_LEASE_TTL=45s
AGENTSPOOL_NODE_TIMEOUT=35s
AGENTSPOOL_REAPER_INTERVAL=2s
AGENTSPOOL_MAX_REQUEST_BYTES=0
AGENTSPOOL_MAX_ARTIFACT_BYTES=0
AGENTSPOOL_EVENT_RETENTION=0
AGENTSPOOL_PUBLIC_METRICS=false

# Optional worker settings
AGENTSPOOL_WORKER_NAME=my-worker
AGENTSPOOL_WORKER_DATA_DIR=/var/lib/agentspool/worker
AGENTSPOOL_WORKER_LABELS=room=office,tier=primary
AGENTSPOOL_WORKER_QUEUES=default
AGENTSPOOL_WORKER_ALLOWED_EXECUTORS=shell
AGENTSPOOL_WORKER_MAX_CONCURRENCY=2
AGENTSPOOL_WORKER_POLL_INTERVAL=1500ms
AGENTSPOOL_WORKER_HEARTBEAT_INTERVAL=10s
AGENTSPOOL_WORKER_REQUEST_TIMEOUT=30s
AGENTSPOOL_WORKER_TRANSFER_TIMEOUT=0
AGENTSPOOL_WORKER_ALLOW_NETWORK=false
AGENTSPOOL_WORKER_ALLOW_HOST_NETWORK=false
AGENTSPOOL_WORKER_INHERIT_HOST_ENV=false
AGENTSPOOL_WORKER_KEEP_JOBS=false
AGENTSPOOL_WORKER_KEEP_FAILED_JOBS=true
AGENTSPOOL_WORKER_MAX_OUTPUT_BYTES=0
AGENTSPOOL_WORKER_CACHE_MAX_BYTES=0
AGENTSPOOL_WORKER_GRACEFUL_TIMEOUT=0
# AGENTSPOOL_WORKER_SECRETS_FILE=/etc/agentspool/worker.secrets
