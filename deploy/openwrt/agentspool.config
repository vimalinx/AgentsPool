config server 'main'
        option enabled '1'
        option listen '0.0.0.0:8090'
        option data_dir '/mnt/ssd/agentspool/server'
        option admin_token 'replace-with-output-of-agentspool-token'
        option allocator_token 'replace-with-a-different-output-of-agentspool-token'
        option join_token 'replace-with-a-different-output-of-agentspool-token'
        option lease_ttl '45s'
        option node_timeout '35s'
        option max_artifact_bytes '0'
        option event_retention '0'
        option public_metrics '0'
        option log_level 'info'

config worker 'router'
        option enabled '0'
        option server 'http://127.0.0.1:8090'
        option data_dir '/mnt/ssd/agentspool/worker'
        option name 'soft-router'
        option join_token 'replace-with-control-plane-join-token'
        option labels 'role=router'
        option queues 'router-light'
        option executors 'shell,process'
        option max_concurrency '1'
        option request_timeout '30s'
        option transfer_timeout '0'
        option log_level 'info'
