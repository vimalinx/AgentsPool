AGENTSPOOL_SERVER=http://control-plane.example.invalid:8090
# Required for first registration only. Remove this setting and the file after credentials.json exists.
AGENTSPOOL_JOIN_TOKEN_FILE=/etc/agentspool/worker-join.token
AGENTSPOOL_WORKER_NAME=main-pc
AGENTSPOOL_WORKER_DATA_DIR=/var/lib/agentspool/worker
# Labels are Worker-reported factual tags. Record human intent and Agent advice with devices.annotate.
AGENTSPOOL_WORKER_LABELS=room=office,tier=primary
AGENTSPOOL_WORKER_QUEUES=default
AGENTSPOOL_WORKER_DETECT_GPU=false
AGENTSPOOL_WORKER_ALLOWED_EXECUTORS=shell
AGENTSPOOL_WORKER_MAX_CONCURRENCY=2
AGENTSPOOL_WORKER_POLL_INTERVAL=1500ms
AGENTSPOOL_WORKER_HEARTBEAT_INTERVAL=10s
AGENTSPOOL_WORKER_REQUEST_TIMEOUT=30s
AGENTSPOOL_WORKER_TRANSFER_TIMEOUT=0
AGENTSPOOL_WORKER_ALLOW_NETWORK=false
AGENTSPOOL_WORKER_ALLOW_HOST_NETWORK=false
AGENTSPOOL_WORKER_INHERIT_HOST_ENV=false
AGENTSPOOL_WORKER_KEEP_JOBS=false
AGENTSPOOL_WORKER_KEEP_FAILED_JOBS=true
AGENTSPOOL_WORKER_MAX_OUTPUT_BYTES=0
AGENTSPOOL_WORKER_CACHE_MAX_BYTES=0
AGENTSPOOL_WORKER_GRACEFUL_TIMEOUT=0
# AGENTSPOOL_WORKER_SECRETS_FILE=/etc/agentspool/worker.secrets
AGENTSPOOL_LOG_FORMAT=json
AGENTSPOOL_LOG_LEVEL=info
