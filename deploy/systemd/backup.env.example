# Public age recipient file. It must contain no private identity.
AGENTSPOOL_BACKUP_RECIPIENT_FILE=/etc/agentspool/backup-recipients.txt

# Encrypted archives are copied here and verified remotely.
AGENTSPOOL_BACKUP_DESTINATION=backup-user@backup-host:/srv/backups/agentspool

# Optional overrides:
# AGENTSPOOL_BACKUP_DATA_ROOT=/var/lib/agentspool
# AGENTSPOOL_BACKUP_SERVICE=agentspool-server.service
